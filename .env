# Ed25519 public key (hex, HotPocket "ed" prefixed format) of the maintainer allowed to upgrade this contract.
# REPLACE this value with your own maintainer public key before deploying (upgrade-client prints it for you).
MAINTAINER_PUBKEY=ed5cb5b5e0f6a1d2c3b4a5968778695a4b3c2d1e0f1a2b3c4d5e6f708192a3b4c5
# HotPocket public key that becomes the first admin on first start (replaces ADMIN_EMAIL/ADMIN_PASSWORD).
# Leave empty to use MAINTAINER_PUBKEY. REPLACE with the admin's HotPocket public key if different.
ADMIN_PUBKEY=
# Seed the 12 demo products and demo reviews when the catalogue is empty (true/false).
SEED_DEMO_DATA=true
# SQLite database file, relative to the contract working directory.
DB_PATH=ratings.db
